# Cloudlog / Wavelog
CQK1AF_CLOUDLOG__URL=https://your-cloudlog.example.com
CQK1AF_CLOUDLOG__API_KEY=replace-me
CQK1AF_CLOUDLOG__STATION_PROFILE_ID=1

